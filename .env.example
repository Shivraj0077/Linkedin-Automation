# Copy this file to .env and fill in real values LOCALLY.
# NEVER commit .env -- it's already in .gitignore.
#
# These come from an authenticated LinkedIn browser session (DevTools ->
# Application -> Cookies -> https://www.linkedin.com), using a dedicated
# test account per assignment requirement #4/#28. Do not use your
# personal LinkedIn account for this.

# The li_at cookie value (long opaque token). This is the primary
# session credential -- treat it like a password.
LINKEDIN_LI_AT=

# The JSESSIONID cookie value. LinkedIn issues this already wrapped in
# literal double quotes (e.g. "ajax:1234567890123456789") -- paste it
# exactly as the browser shows it, quotes included. This same value is
# also sent as the csrf-token request header (see app/config.py).
LINKEDIN_JSESSIONID=

# Optional but strongly recommended: the rest of your browser's LinkedIn
# cookie jar (bcookie, bscookie, lidc, lang, etc.), pasted verbatim as a
# single "name=value; name2=value2" string (DevTools -> Network -> pick
# any linkedin.com request -> Request Headers -> copy the whole `cookie`
# header value). li_at/JSESSIONID alone are enough for the flagship-web
# RSC endpoints (experience/education/skills), but LinkedIn's legacy
# Voyager identity endpoint -- the only source for name/first_name/
# last_name/profile_image/location backfill -- applies much stricter
# session validation and will 302 back to itself (a checkpoint
# challenge) most of the time without these extra cookies present.
LINKEDIN_EXTRA_COOKIES=

# --- Optional overrides (sensible defaults are baked into app/config.py) ---

# Request timeout, in seconds, for each individual LinkedIn HTTP call.
# REQUEST_TIMEOUT_SECONDS=15

# Safety cap on how many pages the Skills paginator will fetch for a
# single profile, even if LinkedIn keeps indicating more pages exist.
# MAX_SKILLS_PAGES=20
